generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// 1. Profiles
model Profile {
  id             String    @id // Links to auth.users.id
  email          String    @unique
  displayName    String?   @map("display_name")
  avatarUrl      String?   @map("avatar_url")
  level          Int       @default(1)
  totalXp        Int       @default(0) @map("total_xp")
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  projects             Project[]
  tasks                Task[]
  tags                 Tag[]
  habits               Habit[]
  focusSessions        FocusSession[]
  xpLogs               XPLog[]
  aiLogs               AIActivityLog[]
  areas                AreaOfLife[]
  pages                Page[]
  sharedProjectsOwned  SharedProject[] @relation("SharedByUser")
  sharedProjectsAccess SharedProject[] @relation("SharedWithUser")
  sharedPagesOwned     SharedPage[]    @relation("SharedPageByUser")
  sharedPagesAccess    SharedPage[]    @relation("SharedPageWithUser")

  @@map("profiles")
}

// 2. Projects
model Project {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  color       String?
  icon        String?
  
  // Project Database Fields
  status      ProjectStatus    @default(ACTIVE)
  priority    ProjectPriority  @default(MEDIUM)
  startDate   DateTime?        @map("start_date") @db.Timestamptz
  targetDate  DateTime?        @map("target_date") @db.Timestamptz
  
  isArchived  Boolean  @default(false) @map("is_archived")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  owner      Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections   Section[]
  tasks      Task[]
  sharedWith SharedProject[]

  areaId String?      @map("area_id")
  area   AreaOfLife? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([areaId])
  @@index([status])
  @@map("projects")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum ProjectPriority {
  HIGH
  MEDIUM
  LOW
}

// 3. Sections
model Section {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@map("sections")
}

// 4. Tasks
model Task {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  projectId       String?   @map("project_id")
  sectionId       String?   @map("section_id")

  title       String
  description String?
  priority    String? // 'low', 'medium', 'high', 'urgent' or null

  dueDate DateTime? @map("due_date") @db.Timestamptz

  // Calendar & Time Blocking Fields
  scheduledStart  DateTime? @map("scheduled_start") @db.Timestamptz
  scheduledEnd    DateTime? @map("scheduled_end") @db.Timestamptz
  durationMinutes Int?      @map("duration_minutes")

  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  xpEarned  Int @default(0) @map("xp_earned")
  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user          Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  section       Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  tags          TaskTag[]
  reminders     Reminder[]
  focusSessions FocusSession[]

  @@index([userId])
  @@index([projectId])
  @@index([sectionId])
  @@index([userId, projectId]) // Optimized for Inbox (projectId: null)
  @@index([userId, completed]) // Optimized for Dashboard (active tasks)
  @@index([userId, completed, completedAt]) // Optimized for Stats/History
  @@map("tasks")
}

// 5. Tags
model Tag {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  color     String?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user  Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks TaskTag[]

  @@unique([userId, name])
  @@map("tags")
}

// 6. Task Tags (Many-to-Many)
model TaskTag {
  taskId    String   @map("task_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

// 7. Reminders
model Reminder {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  remindAt  DateTime @map("remind_at") @db.Timestamptz
  isSent    Boolean  @default(false) @map("is_sent")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([remindAt])
  @@map("reminders")
}

// 8. Habits
model Habit {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  name            String
  description     String?
  frequency       String    // 'daily', 'weekly', 'custom'
  targetDays      Int[]     @map("target_days")
  icon            String?
  color           String?
  xpPerCompletion Int       @default(10) @map("xp_per_completion")
  currentStreak   Int       @default(0) @map("current_streak")
  bestStreak      Int       @default(0) @map("best_streak")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user        Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  @@map("habits")
}

// 9. Habit Completions
model HabitCompletion {
  id          String   @id @default(uuid())
  habitId     String   @map("habit_id")
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz
  xpEarned    Int      @default(0) @map("xp_earned")
  notes       String?

  // Relations
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId])
  @@map("habit_completions")
}

// 10. Focus Sessions
model FocusSession {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  taskId          String?   @map("task_id")
  durationMinutes Int       @map("duration_minutes")
  startedAt       DateTime  @map("started_at") @db.Timestamptz
  endedAt         DateTime? @map("ended_at") @db.Timestamptz
  completed       Boolean   @default(false)
  xpEarned        Int       @default(0) @map("xp_earned")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("focus_sessions")
}

// 11. XP Logs
model XPLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  amount      Int
  source      String   // 'task', 'habit', 'focus_session', 'streak', 'achievement', 'daily_login', 'other'
  sourceId    String?  @map("source_id")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("xp_logs")
}

// 12. AI Activity Logs
model AIActivityLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  actionType   String   @map("action_type") // 'task_generation', 'schedule_optimization', 'priority_suggestion', 'habit_recommendation', 'other'
  inputData    Json?    @map("input_data")
  outputData   Json?    @map("output_data")
  success      Boolean  @default(true)
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_activity_logs")
}

// 13. Areas of Life
model AreaOfLife {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  icon      String?
  color     String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user     Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  @@map("areas_of_life")
}

// 14. Shared Projects
model SharedProject {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  sharedByUserId   String   @map("shared_by_user_id")
  sharedWithUserId String   @map("shared_with_user_id")
  permission       String   @default("view") // 'view', 'edit', 'admin'
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sharedBy   Profile @relation("SharedByUser", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWith Profile @relation("SharedWithUser", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([projectId, sharedWithUserId])
  @@map("shared_projects")
}

// 15. Shared Pages
model SharedPage {
  id               String   @id @default(uuid())
  pageId           String   @map("page_id")
  sharedByUserId   String   @map("shared_by_user_id")
  sharedWithUserId String   @map("shared_with_user_id")
  permission       String   @default("view") // 'view', 'edit', 'admin'
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  page       Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sharedBy   Profile @relation("SharedPageByUser", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWith Profile @relation("SharedPageWithUser", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([pageId, sharedWithUserId])
  @@map("shared_pages")
}

// ========================================
// PRIVATE PAGES SYSTEM (OPTIMIZED)
// ========================================

// 15. Private Pages
model Page {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  parentPageId String?  @map("parent_page_id")
  title        String   @default("Untitled")
  icon         String?  @default("📄")
  coverImage   String?  @map("cover_image")
  isFavorited  Boolean  @default(false) @map("is_favorited")
  isArchived   Boolean  @default(false) @map("is_archived")  // Soft delete
  sortOrder    Int      @default(0) @map("sort_order")
  depth        Int      @default(0)  // Nesting depth (max 5)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  user       Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentPage Page?   @relation("PageHierarchy", fields: [parentPageId], references: [id], onDelete: Cascade)
  childPages Page[]  @relation("PageHierarchy")
  blocks     Block[]
  sharedWith SharedPage[]

  @@index([userId])
  @@index([parentPageId])
  @@index([userId, isArchived])
  @@map("pages")
}

// 16. Blocks (Content within pages)
model Block {
  id            String    @id @default(uuid())
  pageId        String    @map("page_id")
  parentBlockId String?   @map("parent_block_id")
  parentItemId  String?   @map("parent_item_id")  // For blocks inside database items
  type          BlockType
  content       Json      @default("{}")
  sortOrder     Int       @default(0) @map("sort_order")
  isArchived    Boolean   @default(false) @map("is_archived")  // Soft delete
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  page               Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parentBlock        Block?             @relation("BlockNesting", fields: [parentBlockId], references: [id], onDelete: Cascade)
  childBlocks        Block[]            @relation("BlockNesting")
  parentItem         DatabaseItem?      @relation("ItemContent", fields: [parentItemId], references: [id], onDelete: Cascade)
  databaseViews      DatabaseView[]     // One block can have MULTIPLE views
  databaseItems      DatabaseItem[]     // Items in this database block
  databaseProperties DatabaseProperty[] // Properties/columns in this database block

  @@index([pageId])
  @@index([parentBlockId])
  @@index([parentItemId])
  @@index([pageId, sortOrder])
  @@index([pageId, isArchived])
  @@map("blocks")
}

// 17. Database Views (MULTIPLE views per database block)
model DatabaseView {
  id            String     @id @default(uuid())
  blockId       String     @map("block_id")  // NO UNIQUE - allows multiple views
  name          String     @default("Default View")  // View name for switching
  viewType      ViewType   @map("view_type")
  filters       Json?      @default("[]")
  sorts         Json?      @default("[]")
  visibleFields Json?      @default("[]") @map("visible_fields")
  groupBy       String?    @map("group_by")
  isDefault     Boolean    @default(false) @map("is_default")  // Which view shows first
  sortOrder     Int        @default(0) @map("sort_order")  // Order in view switcher
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  // Relations
  block Block @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId])
  @@map("database_views")
}

// 18. Database Items (Rows/Cards in inline databases)
model DatabaseItem {
  id          String   @id @default(uuid())
  blockId     String   @map("block_id")
  title       String   @default("Untitled")
  icon        String?
  coverImage  String?  @map("cover_image")
  properties  Json     @default("{}")  // Property values keyed by property ID
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  block       Block         @relation(fields: [blockId], references: [id], onDelete: Cascade)
  childBlocks Block[]       @relation("ItemContent")  // Blocks inside the item (page content)

  @@index([blockId])
  @@index([blockId, sortOrder])
  @@map("database_items")
}

// 19. Database Properties (Column definitions for inline databases)
model DatabaseProperty {
  id        String       @id @default(uuid())
  blockId   String       @map("block_id")
  name      String       @default("Property")
  type      String       @default("TEXT")  // TEXT, NUMBER, SELECT, MULTI_SELECT, DATE, CHECKBOX, URL, EMAIL, PHONE
  options   Json?        @default("[]")  // For select/multi-select options
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // Relations
  block Block @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId])
  @@map("database_properties")
}

// ========================================
// ENUMS FOR PRIVATE PAGES
// ========================================

enum BlockType {
  // Database blocks
  DATABASE_TABLE
  DATABASE_BOARD
  DATABASE_GALLERY
  DATABASE_LIST
  DATABASE_CALENDAR
  DATABASE_CHART

  // Content blocks
  TEXT
  HEADING_1
  HEADING_2
  HEADING_3
  TOGGLE_HEADING_1
  TOGGLE_HEADING_2
  TOGGLE_HEADING_3
  BULLETED_LIST
  NUMBERED_LIST
  TODO_LIST
  TOGGLE_LIST
  CALLOUT
  QUOTE
  CODE
  DIVIDER

  // Media blocks
  IMAGE
  VIDEO
  FILE
}

enum SourceType {
  TASKS
  PROJECTS
  HABITS
}

enum ViewType {
  TABLE
  BOARD
  GALLERY
  LIST
  CALENDAR
  CHART
}
