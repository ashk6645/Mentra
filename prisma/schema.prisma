generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// Enums
enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum PermissionLevel {
  VIEWER
  EDITOR
  OWNER
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

// 1. Profiles
model Profile {
  id             String    @id @default(uuid()) // Links to auth.users.id
  email          String    @unique
  displayName    String?   @map("display_name")
  avatarUrl      String?   @map("avatar_url")
  preferences    Json?     @default("{}")
  xp             Int       @default(0)
  level          Int       @default(1)
  streakCount    Int       @default(0) @map("streak_count")
  lastActiveAt   DateTime? @map("last_active_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  projects       Project[]
  tasks          Task[]
  tags           Tag[]
  habits         Habit[]
  focusSessions  FocusSession[]
  xpLogs         XPLog[]
  aiLogs         AIActivityLog[]
  areas          AreaOfLife[]
  sharedProjects SharedProject[]

  @@map("profiles")
}

// 2. Projects
model Project {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  color       String?  @default("neutral")
  icon        String?
  isArchived  Boolean  @default(false) @map("is_archived")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  owner       Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections    Section[]
  tasks       Task[]
  sharedWith  SharedProject[]
  
  areaId      String?         @map("area_id")
  area        AreaOfLife?     @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([areaId])
  @@map("projects")
}

// 3. Sections
model Section {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId])
  @@map("sections")
}

// 4. Tasks
model Task {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  projectId      String?   @map("project_id")
  sectionId      String?   @map("section_id")
  parentTaskId   String?   @map("parent_task_id")
  
  title          String
  description    String?   @db.Text
  priority       Priority  @default(NONE)
  
  dueDate        DateTime? @map("due_date") @db.Date // Store date only
  dueTime        DateTime? @map("due_time") @db.Time // Store time only? Or use full DateTime in DB
  
  isCompleted    Boolean   @default(false) @map("is_completed")
  completedAt    DateTime? @map("completed_at")
  
  isRecurring    Boolean   @default(false) @map("is_recurring")
  recurrenceRule String?   @map("recurrence_rule") // RRule string
  
  sortOrder      Int       @default(0) @map("sort_order")
  
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  user           Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  section        Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parentTask     Task?     @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks       Task[]    @relation("SubTasks")
  tags           TaskTag[]
  reminders      Reminder[]
  focusSessions  FocusSession[]

  @@index([userId])
  @@index([projectId])
  @@index([dueDate])
  @@map("tasks")
}

// 5. Tags
model Tag {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  color     String?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     TaskTag[]

  @@unique([userId, name])
  @@map("tags")
}

// 6. Task Tags (Many-to-Many)
model TaskTag {
  taskId String @map("task_id")
  tagId  String @map("tag_id")

  // Relations
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

// 7. Reminders
model Reminder {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  remindAt  DateTime @map("remind_at")
  isSent    Boolean  @default(false) @map("is_sent")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([remindAt])
  @@map("reminders")
}

// 8. Habits (Hybrid)
model Habit {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  name            String
  frequency       RecurrenceFrequency @default(DAILY)
  streakCount     Int       @default(0) @map("streak_count")
  lastCompletedAt DateTime? @map("last_completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  user            Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions     HabitCompletion[]

  @@map("habits")
}

// 9. Habit Completions
model HabitCompletion {
  id          String   @id @default(uuid())
  habitId     String   @map("habit_id")
  completedAt DateTime @default(now()) @map("completed_at")

  // Relations
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId])
  @@map("habit_completions")
}

// 10. Focus Sessions
model FocusSession {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  taskId          String?   @map("task_id")
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationMinutes Int?      @map("duration_minutes")
  interruptions   Int       @default(0)

  // Relations
  user            Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  task            Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("focus_sessions")
}

// 11. XP Logs
model XPLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String   // e.g., "TASK_COMPLETION", "STREAK_BONUS"
  points    Int
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("xp_logs")
}

// 12. AI Activity Logs
model AIActivityLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  prompt      String   @db.Text
  response    String   @db.Text
  actionTaken String?  @map("action_taken")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_activity_logs")
}

// 13. Areas of Life
model AreaOfLife {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  icon      String?
  color     String?
  sortOrder Int      @default(0) @map("sort_order")
  
  // Relations
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@map("areas_of_life")
}

// 14. Shared Projects
model SharedProject {
  id                String          @id @default(uuid())
  projectId         String          @map("project_id")
  sharedWithUserId  String         @map("shared_with_user_id")
  permissionLevel   PermissionLevel @default(VIEWER) @map("permission_level")
  createdAt         DateTime        @default(now()) @map("created_at")

  // Relations
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sharedWith        Profile         @relation(fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([projectId, sharedWithUserId])
  @@map("shared_projects")
}
