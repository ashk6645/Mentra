generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// 1. Profiles
model Profile {
  id             String    @id // Links to auth.users.id
  email          String    @unique
  displayName    String?   @map("display_name")
  avatarUrl      String?   @map("avatar_url")
  level          Int       @default(1)
  totalXp        Int       @default(0) @map("total_xp")
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  projects             Project[]
  tasks                Task[]
  tags                 Tag[]
  habits               Habit[]
  focusSessions        FocusSession[]
  xpLogs               XPLog[]
  aiLogs               AIActivityLog[]
  areas                AreaOfLife[]
  sharedProjectsOwned  SharedProject[] @relation("SharedByUser")
  sharedProjectsAccess SharedProject[] @relation("SharedWithUser")

  @@map("profiles")
}

// 2. Projects
model Project {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  color       String?
  icon        String?
  isArchived  Boolean  @default(false) @map("is_archived")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  owner      Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections   Section[]
  tasks      Task[]
  sharedWith SharedProject[]

  areaId String?      @map("area_id")
  area   AreaOfLife? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([areaId])
  @@map("projects")
}

// 3. Sections
model Section {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@map("sections")
}

// 4. Tasks
model Task {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  projectId       String?   @map("project_id")
  sectionId       String?   @map("section_id")

  title       String
  description String?
  priority    String? // 'low', 'medium', 'high', 'urgent' or null

  dueDate DateTime? @map("due_date") @db.Timestamptz

  // Calendar & Time Blocking Fields
  scheduledStart  DateTime? @map("scheduled_start") @db.Timestamptz
  scheduledEnd    DateTime? @map("scheduled_end") @db.Timestamptz
  durationMinutes Int?      @map("duration_minutes")

  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  xpEarned  Int @default(0) @map("xp_earned")
  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user          Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  section       Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  tags          TaskTag[]
  reminders     Reminder[]
  focusSessions FocusSession[]

  @@index([userId])
  @@index([projectId])
  @@index([sectionId])
  @@map("tasks")
}

// 5. Tags
model Tag {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  color     String?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user  Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks TaskTag[]

  @@unique([userId, name])
  @@map("tags")
}

// 6. Task Tags (Many-to-Many)
model TaskTag {
  taskId    String   @map("task_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

// 7. Reminders
model Reminder {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  remindAt  DateTime @map("remind_at") @db.Timestamptz
  isSent    Boolean  @default(false) @map("is_sent")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([remindAt])
  @@map("reminders")
}

// 8. Habits
model Habit {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  name            String
  description     String?
  frequency       String    // 'daily', 'weekly', 'custom'
  targetDays      Int[]     @map("target_days")
  icon            String?
  color           String?
  xpPerCompletion Int       @default(10) @map("xp_per_completion")
  currentStreak   Int       @default(0) @map("current_streak")
  bestStreak      Int       @default(0) @map("best_streak")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user        Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  @@map("habits")
}

// 9. Habit Completions
model HabitCompletion {
  id          String   @id @default(uuid())
  habitId     String   @map("habit_id")
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz
  xpEarned    Int      @default(0) @map("xp_earned")
  notes       String?

  // Relations
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId])
  @@map("habit_completions")
}

// 10. Focus Sessions
model FocusSession {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  taskId          String?   @map("task_id")
  durationMinutes Int       @map("duration_minutes")
  startedAt       DateTime  @map("started_at") @db.Timestamptz
  endedAt         DateTime? @map("ended_at") @db.Timestamptz
  completed       Boolean   @default(false)
  xpEarned        Int       @default(0) @map("xp_earned")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@map("focus_sessions")
}

// 11. XP Logs
model XPLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  amount      Int
  source      String   // 'task', 'habit', 'focus_session', 'streak', 'achievement', 'daily_login', 'other'
  sourceId    String?  @map("source_id")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("xp_logs")
}

// 12. AI Activity Logs
model AIActivityLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  actionType   String   @map("action_type") // 'task_generation', 'schedule_optimization', 'priority_suggestion', 'habit_recommendation', 'other'
  inputData    Json?    @map("input_data")
  outputData   Json?    @map("output_data")
  success      Boolean  @default(true)
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_activity_logs")
}

// 13. Areas of Life
model AreaOfLife {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  icon      String?
  color     String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user     Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  @@map("areas_of_life")
}

// 14. Shared Projects
model SharedProject {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  sharedByUserId   String   @map("shared_by_user_id")
  sharedWithUserId String   @map("shared_with_user_id")
  permission       String   @default("view") // 'view', 'edit', 'admin'
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sharedBy   Profile @relation("SharedByUser", fields: [sharedByUserId], references: [id], onDelete: Cascade)
  sharedWith Profile @relation("SharedWithUser", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([projectId, sharedWithUserId])
  @@map("shared_projects")
}
